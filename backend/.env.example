# AtlasRail API — environment template
# Copy to `.env` and adjust. NEVER commit a real .env file.

# Runtime environment: development | production
AtlasRail_ENVIRONMENT=development

# JWT signing key — REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AtlasRail_SECRET_KEY=

# Token lifetime (minutes)
AtlasRail_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login rate limit: attempts per window
AtlasRail_LOGIN_RATE_LIMIT=10
AtlasRail_LOGIN_RATE_WINDOW=60

# Allowed browser origins (comma-separated or JSON list)
AtlasRail_CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
